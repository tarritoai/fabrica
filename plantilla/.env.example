# Copia este archivo como .env (en la misma carpeta) y pega tus claves. .env NUNCA se sube a git.
# Nada de esto hace falta para `uv run reels humo` (la prueba gratis).

# Voces (obligatoria para hacer tus propios reels): elevenlabs.io → Developers → API keys
ELEVENLABS_API_KEY=

# Opcional: render en una GPU alquilada (`reels render --cloud`). console.vast.ai → Account → API Keys
VAST_API_KEY=

# Opcional y avanzado: leer métricas de Instagram (`reels stats`)
IG_ACCESS_TOKEN=

# Opcional: solo para `reels script` (escribir guiones por API, cobra por uso). La fábrica NO la necesita:
# los guiones los escribe Claude Code con tu suscripción. Ojo: si la pones en tu sistema (no aquí),
# Claude Code cobrará por API en vez de usar tu suscripción.
# ANTHROPIC_API_KEY=
# REELS_SCRIPT_MODEL=claude-opus-5-5

# Opcionales: rutas de programas si `reels doctor` no los encuentra solo (relativas a esta carpeta o absolutas)
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# FFMPEG_BIN=tools/bin/ffmpeg
# FFPROBE_BIN=tools/bin/ffprobe
# RHUBARB_BIN=tools/Rhubarb-Lip-Sync-1.14.0-Windows/rhubarb.exe
# WHISPER_BIN=tools/whisper/whisper-cli
# WHISPER_MODEL=models/ggml-small.bin
# Máquinas sin GPU (máquinas virtuales): render con Cycles en CPU
# REELS_RENDER_ENGINE=cycles
