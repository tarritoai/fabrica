# Copia este archivo como .env (en la misma carpeta) y pega tus claves. .env NUNCA se sube a git.
# Nada de esto hace falta para `uv run reels humo` ni para `uv run reels ejemplo quijote-gafas` (gratis).

# Voces, música y efectos: elevenlabs.io → Developers → API keys
ELEVENLABS_API_KEY=

# Opcional y avanzado: leer métricas de Instagram (`reels stats`)
IG_ACCESS_TOKEN=

# Opcionales: rutas de programas si `reels doctor` no los encuentra solo (relativas a esta carpeta o absolutas)
# FFMPEG_BIN=tools/ffmpeg-9.0/bin/ffmpeg
# FFPROBE_BIN=tools/ffmpeg-9.0/bin/ffprobe
# WHISPER_BIN=tools/whisper-1.9.5/whisper-cli
# WHISPER_MODEL=models/ggml-small.bin
# NODE_BIN=tools/node-24.22.0/bin/node
